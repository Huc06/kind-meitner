:80 {
	map {host} {upstream_scheme} {
		{$KIND_MEITNER_HTTPS_HOST:https-disabled.invalid} {$KIND_MEITNER_UPSTREAM_SCHEME:http}
		default http
	}
	encode zstd gzip
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800
	}
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-Proto {upstream_scheme}
			flush_interval -1
		}
	}
}
