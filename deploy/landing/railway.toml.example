# Copy this file to the repository root as railway.toml only for the dedicated
# landing deployment branch/repository. The primary repository's railway.toml
# intentionally continues to deploy the Kind Meitner backend service.

[build]
builder = "DOCKERFILE"
dockerfilePath = "deploy/landing/Dockerfile"

[deploy]
healthcheckPath = "/"
healthcheckTimeout = 60
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
